{
  "name": "britepulse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "britepulse": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "dev": "node dist/cli.js",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.5",
    "vite": "8.3.5"
  },
  "description": "Local frontend performance measurement and bundle comparisons",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "peerDependencies": {
    "vite": "8.3.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
