{
  "name": "britepulse-workspace",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @britepulse/report dev",
    "build": "node scripts/build-package.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test.mjs",
    "test:compatibility": "node scripts/compatibility.mjs",
    "test:native": "node scripts/probe-next-native.mjs",
    "test:synthetic": "node fixtures/synthetic/probe.mjs",
    "test:package": "pnpm --filter @britepulse/integration run test:package",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "pnpm --filter @britepulse/integration run test:integration"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "prettier": "3.9.10",
    "@types/node": "26.6.5",
    "eslint-plugin-sonarjs": "4.2.2"
  }
}
